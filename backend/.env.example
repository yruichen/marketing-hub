# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=true

# Demo/test account controls
MARKETING_HUB_BOOTSTRAP_DEMO=true
MARKETING_HUB_ADMIN_USERNAME=ROOT
MARKETING_HUB_ADMIN_PASSWORD=123
MARKETING_HUB_DEMO_USERNAME=DEMO
MARKETING_HUB_DEMO_PASSWORD=123
ALLOW_UNAUTHENTICATED_API=true

# Database
# Leave DATABASE_URL/POSTGRES_* unset to use local SQLite.
# POSTGRES_DB=marketing_hub
# POSTGRES_USER=marketing_hub
# POSTGRES_PASSWORD=marketing_hub
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_EAGER_PROPAGATES=true

# Email verification / transactional email
# Phase 1 will read these values. Use console for local development,
# then switch to resend after DNS verification and API key setup.
EMAIL_PROVIDER=console
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Marketing Hub <no-reply@example.com>
FRONTEND_BASE_URL=http://localhost:5173

# AI provider controls
AI_ALLOW_MOCK_PROVIDER=true
AI_ALLOW_MOCK_FALLBACK=true
AGNES_API_KEY=
AGNES_AUTO_ACTIVATE=false
