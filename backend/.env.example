# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-production
# Required when DJANGO_DEBUG=false — encrypts BYOK API keys at rest.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,203.0.113.10
# Include structured error debug payloads in API responses (also enabled when DJANGO_DEBUG=true).
API_ERROR_DEBUG=false
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://203.0.113.10:5173
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://bundle

# Local development authentication. Create users explicitly with registration
# or `uv run python manage.py createsuperuser`.
ALLOW_UNAUTHENTICATED_API=true

# Database
# Leave DATABASE_URL/POSTGRES_* unset to use local SQLite.
# POSTGRES_DB=marketing_hub
# POSTGRES_USER=marketing_hub
# POSTGRES_PASSWORD=marketing_hub
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_EAGER_PROPAGATES=true

# Email verification / transactional email
# Phase 1 will read these values. Use console for local development,
# then switch to resend after DNS verification and API key setup.
EMAIL_PROVIDER=console
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Marketing Hub <no-reply@example.com>
FRONTEND_BASE_URL=http://203.0.113.10:5173

# Production (HTTP, no TLS yet — set to true when HTTPS is enabled)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Packaged desktop clients are cross-site to a remote HTTPS API. Production
# deployments serving desktop clients must use None here and keep both Secure
# flags enabled. Local browser development should keep Lax.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# AI provider controls. Without a configured provider, generation endpoints
# return a setup-required error and the UI links to AI Settings.
AGNES_API_KEY=
AGNES_AUTO_ACTIVATE=false
