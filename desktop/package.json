{
  "name": "marketing-hub-desktop",
  "productName": "Marketing Hub",
  "version": "0.1.0",
  "description": "Secure Electron host for the Marketing Hub web application",
  "author": "Marketing Hub Contributors",
  "homepage": "https://github.com/yruichen/marketing-hub",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "prepackage": "node scripts/check-runtime.mjs",
    "premake": "node scripts/check-runtime.mjs && node scripts/check-release-env.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:renderer": "npm --prefix ../frontend run build && node scripts/sync-renderer.mjs",
    "build": "npm run clean && npm run build:host && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "^24.12.3",
    "electron": "43.3.0",
    "esbuild": "0.28.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
