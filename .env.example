# Docker Compose production overrides (copy to .env on the server).
# Used by docker-compose.prod.yml for frontend build args and port mapping.

# Public API URL baked into the frontend production build.
VITE_API_BASE_URL=http://203.0.113.10:8000/api

# Host port for the frontend container (maps to Nginx :80 inside the container).
FRONTEND_PORT=5173
